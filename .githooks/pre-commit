#!/bin/sh
# L5GN-Tools -- the gate is the door. (Borrowed from Citadel v5 / CID.)
# Runs verify.py and refuses the commit if anything is red.
# Wired up with:  git config core.hooksPath .githooks
#
# Windows: Git for Windows runs this via its bundled bash. No chmod needed --
# mark it executable in git's INDEX instead:
#     git update-index --chmod=+x .githooks/pre-commit

if command -v python >/dev/null 2>&1; then
    PY=python
elif command -v py >/dev/null 2>&1; then
    PY=py
else
    echo "[pre-commit] ERROR: no 'python' or 'py' on PATH -- cannot run the gate."
    exit 1
fi

if [ ! -f verify.py ]; then
    echo "[pre-commit] NOTE: verify.py not present yet -- gate skipped (bootstrap)."
    exit 0
fi

# git sets GIT_DIR / GIT_WORK_TREE / GIT_INDEX_FILE / GIT_PREFIX in a hook's
# environment, pointing at THIS repo mid-commit (index locked). verify.py runs
# testers that spin up their OWN throwaway git repos in temp dirs (tester_
# env_tracked, tester_blast_radius, tester_blast_uncommitted, tester_file_census
# among them) -- if those vars leak into that subprocess's environment, its
# nested `git init`/`git commit` calls collide with this repo's locked index
# instead of using the temp repo's own .git, and fail with a confusing
# CalledProcessError that has nothing to do with what's actually being
# committed. Unset them here so the gate runs in a clean environment, exactly
# as it does when invoked directly (`python verify.py`) outside any hook.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

echo "[pre-commit] running verify gate..."
"$PY" verify.py || {
    echo "[pre-commit] BLOCKED: verify is RED. Fix it, then commit."
    exit 1
}
echo "[pre-commit] verify GREEN -- commit allowed."
exit 0
