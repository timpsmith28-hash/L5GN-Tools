# Generated scan outputs -- reproducible, not source.
/data/
/report.html
data/urls.txt

# Per-machine config override -- paths/secrets, must not sync to GitHub.
/config/local.json

# Project registry -- real project names/aliases, includes employer project
# codenames. Authored here, shipped by scp like local.json, never committed.
/config/project_registry.json

# Project Wizard repo allowlist (DECISIONS 0042) -- per-host absolute paths to
# every repo the toolkit may read or execute stages in, which on the work rig
# means employer repo paths. Same class as project_registry.json: authored
# here, shipped manually, never committed.
#
# NOTE, because this narrows a ratified clause: 0042 clause 2 says widening the
# allowlist is "a reviewed, committed edit". Untracked, it is no longer a
# committed one, and the review 0042 relied on is now whatever the operator
# does before shipping the file. Absence fails closed -- load_allowlist returns
# an empty map, so a fresh clone reads and executes nothing rather than
# defaulting to everything -- but the change is a real step down from clause 2
# and wants its own entry rather than living only in this comment.
/config/project_wizard.allow.json

# Curated conversation maps (DECISIONS 0040) -- one per source. They carry
# conversation titles, which for the MCF map means employer project and thread
# names. Same class as project_registry.json: authored here, shipped manually,
# never committed. The pattern covers future per-source maps so the next one
# does not have to remember this rule.
/config/*conversation_map.tsv

# Chronicler ingest RUNTIME data (per-machine, never code). Only chronicler/ code is tracked.
/chronicler/**/*.db
/chronicler/**/*.db-journal
# WAL sidecars (DECISIONS 0014) -- the -journal rule above does NOT cover these.
/chronicler/**/*.db-wal
/chronicler/**/*.db-shm
/chronicler/**/raw_*/
/chronicler/**/vault_staging/
/chronicler/**/scraped_gemini/
/chronicler/**/zip_downloads/
/chronicler/**/_debug/
# Transient read-surface snapshot + its metadata (DECISIONS 0013), overwritten
# each `run.py serve` launch. Scratch, never source.
/chronicler/**/serve-snapshot/
/chronicler/**/manifest.jsonl

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Stray tester output at repo root (tester_ledger writes it; nothing reads it).
/test_ledger.jsonl
.fuse_hidden*